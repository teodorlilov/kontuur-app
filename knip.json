{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/page.tsx",
    "src/app/**/layout.tsx",
    "src/app/**/route.ts",
    "src/app/**/error.tsx",
    "src/app/**/opengraph-image.tsx",
    "src/**/*.test.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["src/types/database.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["postcss", "tailwindcss"]
}
